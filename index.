<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Game Đuổi Hình Bắt Chữ</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        body { background: linear-gradient(135deg, #74b9ff, #a29bfe); min-height: 100vh; display: flex; justify-content: center; align-items: center; color: #2d3436; }
        .game-container { background: white; padding: 30px; border-radius: 20px; box-shadow: 0 10px 25px rgba(0,0,0,0.2); width: 100%; max-width: 450px; text-align: center; }
        h1 { color: #0984e3; margin-bottom: 10px; font-size: 24px; }
        .score { font-size: 16px; color: #636e72; margin-bottom: 20px; }
        .image-box { background: #dfe6e9; border: 3px dashed #b2bec3; border-radius: 12px; height: 200px; display: flex; justify-content: center; align-items: center; font-size: 22px; font-weight: bold; color: #2d3436; margin-bottom: 20px; padding: 10px; }
        .hint { font-style: italic; color: #e17055; margin-bottom: 15px; min-height: 24px; }
        .input-group { display: flex; gap: 10px; margin-bottom: 15px; }
        input[type="text"] { flex: 1; padding: 12px; border: 2px solid #dfe6e9; border-radius: 8px; font-size: 16px; outline: none; transition: 0.3s; }
        input[type="text"]:focus { border-color: #0984e3; }
        button { background: #0984e3; color: white; border: none; padding: 12px 20px; border-radius: 8px; font-size: 16px; font-weight: bold; cursor: pointer; transition: 0.3s; }
        button:hover { background: #00cec9; }
        .message { font-weight: bold; margin-top: 15px; min-height: 24px; }
        .success { color: #00b894; }
        .error { color: #d63031; }
    </style>
</head>
<body>

    <div class="game-container">
        <h1>🧠 Đuổi Hình Bắt Chữ</h1>
        <div class="score">Điểm: <span id="score">0</span> | Câu: <span id="level">1</span>/3</div>
        
        <div class="image-box" id="question-img">
            Đang tải câu đố...
        </div>
        
        <div class="hint" id="question-hint">Gợi ý: ...</div>

        <div class="input-group">
            <input type="text" id="user-answer" placeholder="Nhập đáp án của bạn..." onkeypress="checkEnter(event)">
            <button onclick="checkAnswer()">Đoán</button>
        </div>

        <div class="message" id="message"></div>
    </div>

    <script>
        // Danh sách câu đố (Bạn có thể thêm bớt tùy ý)
        const quizList = [
            { image: "CÁ + KHO", answer: "cá kho", hint: "Một món ăn rất quen thuộc trong bữa cơm gia đình Việt Nam." },
            { image: "XE + ÔM", answer: "xe ôm", hint: "Dịch vụ di chuyển phổ biến trên đường phố." },
            { image: "BAO + TẢI", answer: "bao tải", hint: "Dùng để đựng lúa gạo hoặc hàng hóa." }
        ];

        let currentIdx = 0;
        let score = 0;

        const imgBox = document.getElementById("question-img");
        const hintBox = document.getElementById("question-hint");
        const inputAnswer = document.getElementById("user-answer");
        const msgBox = document.getElementById("message");
        const scoreBox = document.getElementById("score");
        const levelBox = document.getElementById("level");

        function loadQuestion() {
            if (currentIdx >= quizList.length) {
                imgBox.innerHTML = "🎉 HOÀN THÀNH! 🎉";
                hintBox.innerHTML = "Bạn đã vượt qua tất cả các câu đố.";
                document.querySelector(".input-group").style.display = "none";
                msgBox.innerHTML = `Tổng điểm của bạn: ${score}/${quizList.length * 10}`;
                msgBox.className = "message success";
                return;
            }

            let currentQ = quizList[currentIdx];
            imgBox.innerHTML = currentQ.image;
            hintBox.innerHTML = "Gợi ý: " + currentQ.hint;
            inputAnswer.value = "";
            msgBox.innerHTML = "";
            levelBox.innerText = currentIdx + 1;
        }

        function checkAnswer() {
            let userVal = inputAnswer.value.trim().toLowerCase();
            let correctVal = quizList[currentIdx].answer;

            if (userVal === "") {
                msgBox.innerHTML = "Vui lòng nhập đáp án!";
                msgBox.className = "message error";
                return;
            }

            if (userVal === correctVal) {
                score += 10;
                scoreBox.innerText = score;
                msgBox.innerHTML = "Chính xác! 🎉 Chuẩn bị sang câu tiếp theo...";
                msgBox.className = "message success";
                currentIdx++;
                setTimeout(loadQuestion, 1500);
            } else {
                msgBox.innerHTML = "Sai rồi, thử lại xem nhé! ❌";
                msgBox.className = "message error";
            }
        }

        function checkEnter(e) {
            if (e.key === "Enter") {
                checkAnswer();
            }
        }

        // Khởi chạy game lần đầu
        loadQuestion();
    </script>

</body>
</html>
